---
const {id, name, desc, talent, prereqs, unlocks} = Astro.props;

var borderColor = "";
if (talent === "Agile"){
    borderColor = "#ff0000";
} else if (talent === "Keen"){
    borderColor = "#00ff00";
} else {
    borderColor = "black";
}
---

<div class="skillbox" id={name}>
    ({id}) {name}:
    <div set:html={desc}></div>
    Prerequisites: {prereqs}
    <br>Unlocks: {unlocks}
</div>

<style define:vars={{borderColor}}>
    .skillbox {
        border: solid; 
        border-color: var(--borderColor);
        border-radius: .8em;
        padding: .5em .5em;
        margin: .5em .5em;
    }
</style>
