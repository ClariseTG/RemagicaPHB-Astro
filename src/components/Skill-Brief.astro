---
const {id, name} = Astro.props;

import skillsMaster from "../data/talent-skills.json";

const idNum = Number(id);

    const selected = skillsMaster.filter(
        skill => Number(skill.id) == idNum
    )[0]

var borderColor = "";
if (selected.talent === "Agile"){
    borderColor = "#ff0000";
} else if (selected.talent === "Keen"){
    borderColor = "#00ff00";
} else {
    borderColor = "black";
}
---

<a href={`/compendium/talent-skills#${selected.name}`}>{selected.name}</a>

<style define:vars={{borderColor}}>
    a {
        color: var(--borderColor);
    }
</style>
