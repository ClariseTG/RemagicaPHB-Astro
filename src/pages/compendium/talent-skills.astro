import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';

import skillsMaster from "../../data/talent-skills.json"

const pageTitle="Talent Skills";
//const skillsMaster = await getCollection('talent_skills');
//const parry = await getEntry('talent_skills', '1');

//const { cont } = await render(skillsMaster);

---
<Layout>
    <h1>Talent Skills</h1>
    
    <cont>
    <ul>
        {skillsMaster.filter(
            skill => skill.display
        ).map(
            skill => (
                <li>{skill.name} ({skill.id}): <div set:html={skill.desc}></li>
            )
        )}
    </ul>
    </cont>
</Layout>
