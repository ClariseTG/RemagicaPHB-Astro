---
import {Font} from "astro:assets"
import Navigation from '../components/Navigation.astro'
const pageTitle = "Remagica 4.6 Rules"
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="src/assets/favicon.svg" />
		<link rel="icon" href="src/assets/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
        <Font cssVariable="--font-lexend" />
        <Font cssVariable="--font-montserrat" />
        <Font cssVariable="--font-atkinson" />
        <Navigation />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
        background-color:#ffffff;
        color:#000000;
        padding-top: 3%;
        padding-right: 1.5em;
        padding-left: 1.5em;
        font-family: var(--font-atkinson);
        font-size: 1.1em;
	}

    h1,
    h2,
    h3 {
        font-family: var(--font-lexend);
    }

    a {
        color: #630aab;
    }

    a:hover,
    a:focus {
        color: #c602e8;
    }

    .imgbox {
        display: flex;
        width: 100%;
        max-width:40em;
        align-items: center;
    }

    /* src: https://docs.astro.build/en/tutorial/3-components/3/ */

* {
  box-sizing: border-box;
}

/* nav styles */
/* mobile version */
.nav-links-top {
    margin-left: 1em;
    display: block;
    position: static;
    width: auto;
    background: #f2f2f2;
    border-radius: .8em;
}

.nav-links-top a {
    text-decoration: none;
    display: inline-block;
    padding: .5em .5em;
}

.nav-links {
    display: none;
}

.nav-links-top a:hover,
.nav-links-top a:focus,
.nav-links a:hover,
.nav-links a:focus {
    background-color: #eed4ff;
    border-radius: .8em;
}

@media screen and (min-width: 636px) {
    body {
        margin-left: 8.5em;
        width: 75%;
    }
    
    .nav-links-top {
        display: none;
    }
    
    .nav-links {
        margin-left: -8.5em;
        display: block;
        position: fixed;
        width: 8em;
        background: #f2f2f2;
        border-radius: .8em;
    }

    .nav-links a {
        display: block;
        text-decoration: none;
        padding: .8em .5em;
        width: 100%;
        border-radius: .8em;
    }
}

</style>
